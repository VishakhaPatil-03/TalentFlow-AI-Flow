
# Application
NODE_ENV=development
PORT=3000

# AWS
AWS_REGION=ap-south-1

# S3
S3_BUCKET=YOUR_TALENTFLOW_S3_BUCKET

# Optional Secrets Manager integration
# If this is provided, DB credentials will be read from Secrets Manager.
RDS_SECRET_ARN=

# Database
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=talentflow
DB_USER=talentflow_app
DB_PASSWORD=CHANGE_ME

# CORS
CORS_ORIGIN=*
